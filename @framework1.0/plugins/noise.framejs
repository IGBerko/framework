/* Плагин noise — генерация ландшафта. Framework.noise */
Framework.plugin('noise', {
  version: '1.0.0',
  install(fw) {
    // Детерминированный генератор (mulberry32)
    const rng = seed => {
      let a = (seed >>> 0) || 1;
      return () => {
        a = (a + 0x6D2B79F5) >>> 0;
        let t = a;
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    };
    const hash = (x, y, s) => {
      let h = Math.imul(x, 374761393) + Math.imul(y, 668265263) + Math.imul(s, 144665);
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
    };
    const smooth = t => t * t * (3 - 2 * t);
    const value = (x, y, s) => {
      const xi = Math.floor(x), yi = Math.floor(y), xf = smooth(x - xi), yf = smooth(y - yi);
      const a = hash(xi, yi, s), b = hash(xi + 1, yi, s), c = hash(xi, yi + 1, s), d = hash(xi + 1, yi + 1, s);
      return a + (b - a) * xf + (c - a) * yf + (a - b - c + d) * xf * yf;
    };
    const fbm = (x, y, seed, oct = 4) => {
      let amp = 0.5, f = 1, sum = 0, norm = 0;
      for (let i = 0; i < oct; i++) { sum += value(x * f, y * f, seed + i * 101) * amp; norm += amp; amp *= 0.5; f *= 2; }
      return sum / norm;
    };
    // Карта высот n×n: материк в центре, озёра и река
    function heightmap(n, seed) {
      const out = new Float32Array(n * n);
      for (let y = 0; y < n; y++) for (let x = 0; x < n; x++) {
        const nx = x / n, ny = y / n;
        const dx = nx - 0.5, dy = ny - 0.5, d = Math.sqrt(dx * dx + dy * dy) * 1.6;
        let h = fbm(nx * 4, ny * 4, seed, 5) * 0.8 + (1 - d) * 0.35;
        // извилистая река
        const rx = 0.5 + Math.sin(ny * 6 + seed) * 0.12 + (fbm(ny * 5, 0, seed + 7, 2) - 0.5) * 0.3;
        const rd = Math.abs(nx - rx);
        if (rd < 0.025) h -= (0.025 - rd) * 14;
        out[y * n + x] = h;
      }
      return out;
    }
    fw.noise = { rng, hash, value, fbm, heightmap };
  }
});
