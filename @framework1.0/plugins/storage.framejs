/* Плагин storage — framecloud/1.0/storage
   Обёртка над localStorage: JSON и время жизни (ttl, секунды). */
Framework.plugin('storage', {
  version: '1.0.0',
  install(fw) {
    const P = 'frm:';
    fw.storage = {
      set(key, value, ttl) {
        localStorage.setItem(P + key, JSON.stringify({ v: value, e: ttl ? Date.now() + ttl * 1000 : 0 }));
        return value;
      },
      get(key, fallback) {
        try {
          const raw = localStorage.getItem(P + key);
          if (raw == null) return fallback;
          const o = JSON.parse(raw);
          if (o.e && o.e < Date.now()) { localStorage.removeItem(P + key); return fallback; }
          return o.v;
        } catch (e) { return fallback; }
      },
      remove: key => localStorage.removeItem(P + key),
      clear: () => Object.keys(localStorage).filter(k => k.startsWith(P)).forEach(k => localStorage.removeItem(k))
    };
  }
});
